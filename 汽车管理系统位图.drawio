          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pf-auth-title" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=14;fontStyle=1" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;登录认证流程（JWT 过滤器链）&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="360" x="234" y="8" as="geometry" />
        </mxCell>
        <mxCell id="pf-auth-ch5chain" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=11;align=center;verticalAlign=middle;" value="自上而下阅读：① 登录请求 → ② 签发 Token → ③ 后续请求携带 Authorization → ④ JwtAuthenticationFilter 校验 → 放行或 401。本图为第5章流程系列起点，图5-3～图5-6 均假设已通过本节建立的会话与令牌机制。" vertex="1">
          <mxGeometry height="52" width="720" x="54" y="38" as="geometry" />
        </mxCell>
        <mxCell id="pf-auth-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" value="前端提交登录&lt;div&gt;POST /auth/login&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="180" x="70" y="192" as="geometry" />
        </mxCell>
        <mxCell id="pf-auth-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" value="AuthController.login()&lt;div&gt;校验账号/密码&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="180" x="300" y="192" as="geometry" />
        </mxCell>
        <mxCell id="pf-auth-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" value="生成 LoginResponse&lt;div&gt;返回 token + userInfo&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="200" x="520" y="192" as="geometry" />
        </mxCell>
        <mxCell id="pf-auth-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" value="前端存储 token" vertex="1">
          <mxGeometry height="60" width="160" x="80" y="302" as="geometry" />
        </mxCell>
        <mxCell id="pf-auth-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" value="请求拦截器&lt;div&gt;Authorization: Bearer token&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="200" x="280" y="297" as="geometry" />
        </mxCell>
        <mxCell id="pf-auth-6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" value="JwtAuthenticationFilter&lt;div&gt;解析并校验JWT&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="200" x="520" y="297" as="geometry" />
        </mxCell>
        <mxCell id="pf-auth-7" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;" value="Token&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;有效？&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="80" x="580" y="402" as="geometry" />
        </mxCell>
        <mxCell id="pf-auth-8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" value="设置 SecurityContext&lt;div&gt;放行到Controller&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="200" x="520" y="515" as="geometry" />
        </mxCell>
        <mxCell id="pf-auth-9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" value="返回401/403&lt;div&gt;前端跳转登录&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="200" x="300" y="407" as="geometry" />
        </mxCell>
        <mxCell id="pf-auth-e12" edge="1" parent="1" source="pf-auth-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;" target="pf-auth-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pf-auth-e23" edge="1" parent="1" source="pf-auth-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;" target="pf-auth-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pf-auth-e34" edge="1" parent="1" source="pf-auth-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;exitX=0.1;exitY=1;entryX=0.5;entryY=0;" target="pf-auth-4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="262" />
              <mxPoint x="620" y="280" />
              <mxPoint x="160" y="280" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="pf-auth-e45" edge="1" parent="1" source="pf-auth-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;" target="pf-auth-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pf-auth-e56" edge="1" parent="1" source="pf-auth-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;" target="pf-auth-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pf-auth-e67" edge="1" parent="1" source="pf-auth-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="pf-auth-7">
          <mxGeometry relative="1" as="geometry" />

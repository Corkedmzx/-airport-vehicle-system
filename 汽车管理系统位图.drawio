  <diagram id="ProgramFlow-TaskDispatch" name="任务调度流程">
    <mxGraphModel dx="958" dy="625" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pf-task-term-begin" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;" value="开始" vertex="1">
          <mxGeometry height="40" width="100" x="354" y="62" as="geometry" />
        </mxCell>
        <mxCell id="pf-task-term-end" parent="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;" value="结束" vertex="1">
          <mxGeometry height="40" width="100" x="630" y="524" as="geometry" />
        </mxCell>
        <mxCell id="pf-task-e-begin" edge="1" parent="1" source="pf-task-term-begin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="pf-task-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pf-task-e-end" edge="1" parent="1" source="pf-task-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=14;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="pf-task-term-end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pf-task-title" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=14;fontStyle=1" value="任务调度流程（创建—分配—完成）&lt;br&gt;&lt;font style=&quot;font-size: 11px; color: rgb(85, 85, 85); font-weight: normal;&quot;&gt;HTTP 接口 → Service 事务 → 异步通知 → WebSocket 广播。承接图5-2：以下路径均在已认证请求下执行。&lt;/font&gt;" vertex="1">
          <mxGeometry height="46" width="720" x="54" y="8" as="geometry" />
        </mxCell>
        <mxCell id="pf-task-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" value="创建任务&lt;div&gt;POST /tasks&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="160" x="60" y="146" as="geometry" />
        </mxCell>
        <mxCell id="pf-task-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" value="DispatchTaskService.createTask()&lt;div&gt;校验字段→生成任务编号&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="260" x="260" y="141" as="geometry" />
        </mxCell>
        <mxCell id="pf-task-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" value="分配任务&lt;div&gt;PUT /tasks/{id}/assign&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="200" x="30" y="266" as="geometry" />
        </mxCell>
        <mxCell id="pf-task-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" value="assignTask()&lt;div&gt;校验状态/车辆可用&lt;/div&gt;&lt;div&gt;写入assignedVehicle/Driver&lt;/div&gt;&lt;div&gt;状态=已分配&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="260" x="260" y="251" as="geometry" />
        </mxCell>
        <mxCell id="zr5k1s2xOiLcDNKUUPxj-1" edge="1" parent="1" source="pf-task-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" target="pf-task-term-end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pf-task-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" value="异步通知&lt;div&gt;- Email&lt;/div&gt;&lt;div&gt;- 站内信&lt;/div&gt;&lt;div&gt;- WebSocket任务更新&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="220" x="560" y="256" as="geometry" />
        </mxCell>
        <mxCell id="pf-task-6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" value="完成任务&lt;div&gt;PUT /tasks/{id}/complete&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="190" x="30" y="411" as="geometry" />
        </mxCell>
        <mxCell id="pf-task-7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" value="completeTask()&lt;div&gt;更新任务状态=已完成&lt;/div&gt;&lt;div&gt;更新进度/结束时间&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="260" x="260" y="406" as="geometry" />
        </mxCell>
        <mxCell id="pf-task-8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" value="广播任务状态&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;TASK_STATUS_UPDATE&lt;/span&gt;&lt;/div&gt;" vertex="1">

# 复制本文件为 backend/.env 并填写真实值（.env 已被 Git 忽略，切勿提交）
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)

# ---------- MySQL（必填）----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=airport_vehicle_system
DB_USERNAME=app_user
DB_PASSWORD=

# ---------- JWT（必填，生产请用强随机串）----------
JWT_SECRET=

# ---------- 华为云 IoT MQTT（可选）----------
HUAWEI_IOT_MQTT_ENABLED=false
HUAWEI_IOT_MQTT_BROKER=
HUAWEI_IOT_MQTT_INSTANCE_ID=
HUAWEI_IOT_MQTT_DEVICE_ID=
HUAWEI_IOT_MQTT_DEVICE_SECRET=
HUAWEI_IOT_MQTT_DEVICE_KEY_PATH=

# ---------- 华为「数据转发」HTTP 推送（可选）----------
# 与控制台「转发目标」中 Token 完全一致；平台使用 timestamp/nonce/signature 签名校验
HUAWEI_IOT_FORWARD_WEBHOOK_SECRET=

# ---------- 百度地图（可选）----------
BAIDU_MAP_AK=

# ---------- Druid 监控（可选）----------
# DRUID_USERNAME=
# DRUID_PASSWORD=
